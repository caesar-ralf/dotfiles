#!/usr/bin/env bash
#
# with-secrets: run ONE command with declared secrets in its environment.
# Values come from the OS keychain cache when fresh, else from Proton Pass.
# Nothing is exported into your shell.
#
#   with-secrets -- mvn verify                  # every declared secret
#   with-secrets GITHUB_TOKEN -- gh pr list     # only the ones you name
#
# A variable already set in the environment is left as is (direnv or a manual
# export wins). A secret that can't be fetched is skipped with a warning, so
# the command still runs.

set -o pipefail

__dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
# shellcheck source=../lib.sh
source "${__dir}/../lib.sh"

usage() {
    echo "Usage: with-secrets [NAME ...] -- <command> [args...]" >&2
    echo "       (no NAMEs = every secret listed by \`secret list\`)" >&2
    exit "${1:-0}"
}

case "${1:-}" in -h|--help) usage 0 ;; esac

names=()
while [ $# -gt 0 ] && [ "$1" != "--" ]; do
    names+=("$1")
    shift
done
[ "${1:-}" = "--" ] || usage 1
shift
[ $# -gt 0 ] || usage 1

if [ ${#names[@]} -eq 0 ]; then
    while IFS= read -r n; do names+=("$n"); done < <(secrets_names)
fi

missing=()
for n in ${names[@]+"${names[@]}"}; do
    [ -n "${!n:-}" ] && continue
    if value="$(secrets_get "$n" 2>/dev/null)" && [ -n "$value" ]; then
        export "$n=$value"
    else
        missing+=("$n")
    fi
done
unset value

if [ ${#missing[@]} -gt 0 ]; then
    printf 'with-secrets: could not get %s (check: secret status). Running without.\n' "${missing[*]}" >&2
fi

exec "$@"
