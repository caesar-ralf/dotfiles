# shortcut to this dotfiles path is DOTFILES
export DOTFILES=$HOME/.dotfiles
export DEFAULT_USER=`whoami`

# Keep PATH/fpath entries unique so they don't grow on every nested shell.
typeset -U path PATH fpath

# Homebrew prefix, resolved once (avoids spawning `brew --prefix` repeatedly).
export BREW_PREFIX="${HOMEBREW_PREFIX:-$(brew --prefix)}"

# your project folder that we can `c [tab]` to
export PROJECTS="~/workspace"

# all of our zsh files
# NOTE: use a bounded (depth-2) glob, NOT `**`. A recursive `**/*.zsh` would
# descend into m2.symlink/repository/ (16k+ Maven cache dirs) on every startup.
typeset -U config_files
config_files=($DOTFILES/*/*.zsh)

# load the path files first (files named _path.zsh)
for file in ${(M)config_files:#*/_path.zsh}
do
  source $file
done

# load everything but the path and completion files
for file in ${${config_files:#*/_path.zsh}:#*/completion.zsh}
do
  source $file
done

# Extra completion directories must be on fpath BEFORE compinit runs.
[ -d "$HOME/.docker/completions" ] && fpath=("$HOME/.docker/completions" $fpath)

# Initialize the completion system exactly once, and cheaply:
#   - rebuild the ~/.zcompdump cache at most once every 24h
#   - otherwise trust the cache and skip the slow security audit (-C)
# Because `compinit` is defined afterwards, vendored scripts that do
# `autoload -U +X compinit && compinit` (gcloud, Docker, ...) short-circuit
# and won't re-run it.
autoload -Uz compinit
if [[ -n ${ZDOTDIR:-$HOME}/.zcompdump(#qNmh+24) ]]; then
  compinit
else
  compinit -C
fi

# load every completion after autocomplete loads
for file in ${(M)config_files:#*/completion.zsh}
do
  source $file
done

unset config_files

# ---------------------------------------------------------------------------
# Interactive plugins & tools (all guarded, so a fresh machine still boots).
# Order matters:
#   fzf-tab must load AFTER compinit but BEFORE widget-wrapping plugins.
#   zsh-syntax-highlighting must load LAST (done near the end of this file).
# ---------------------------------------------------------------------------

# fzf: key-bindings (Ctrl-T files, Alt-C cd) + fuzzy completion. Ctrl-R history
# is handled by atuin below (loaded after fzf so it wins that binding).
if command -v fzf >/dev/null 2>&1; then
  # fzf >= 0.48 ships a single entry point; fall back to the old files.
  if fzf --zsh >/dev/null 2>&1; then
    source <(fzf --zsh)
  else
    [ -f "$BREW_PREFIX/opt/fzf/shell/key-bindings.zsh" ] && source "$BREW_PREFIX/opt/fzf/shell/key-bindings.zsh"
    [ -f "$BREW_PREFIX/opt/fzf/shell/completion.zsh" ]  && source "$BREW_PREFIX/opt/fzf/shell/completion.zsh"
  fi
fi

# fzf-tab: replace zsh's tab completion menu with an fzf picker
[ -f "$BREW_PREFIX/share/fzf-tab/fzf-tab.plugin.zsh" ] && source "$BREW_PREFIX/share/fzf-tab/fzf-tab.plugin.zsh"
[ -f "$HOME/.zsh/fzf-tab/fzf-tab.plugin.zsh" ] && source "$HOME/.zsh/fzf-tab/fzf-tab.plugin.zsh"

# atuin: SQLite-backed shell history with context-aware search (cwd, exit code,
# duration, optional E2E sync). It OWNS Ctrl-R and is loaded AFTER fzf so it
# wins that binding; --disable-up-arrow leaves the arrow-key history search
# (configured below) untouched. fzf still handles Ctrl-T, completion and the
# git/* fzf helpers.
command -v atuin >/dev/null 2>&1 && eval "$(atuin init zsh --disable-up-arrow)"

# zoxide: smarter `cd` with frecency (you cd constantly). Use `z <partial>`
# to jump; `cd` still works as normal.
command -v zoxide >/dev/null 2>&1 && eval "$(zoxide init zsh)"

# Better history
# Credits to https://coderwall.com/p/jpj_6q/zsh-better-history-searching-with-arrow-keys
autoload -U up-line-or-beginning-search
autoload -U down-line-or-beginning-search
zle -N up-line-or-beginning-search
zle -N down-line-or-beginning-search
bindkey "^[[A" up-line-or-beginning-search # Up
bindkey "^[[B" down-line-or-beginning-search # Down

# OH-MY-POSH prompt (theme vendored in this repo at oh-my-posh/theme.omp.json).
# To customize, edit that file or run `oh-my-posh config migrate`. Browse other
# built-in themes with `oh-my-posh init zsh --config "$(brew --prefix oh-my-posh)/themes/<name>.omp.json"`.
if command -v oh-my-posh >/dev/null 2>&1; then
  eval "$(oh-my-posh init zsh --config "$DOTFILES/oh-my-posh/theme.omp.json")"
fi

# GOOGLE CLOUD SDK (its internal compinit is skipped; see note above)
source "$BREW_PREFIX/Caskroom/google-cloud-sdk/latest/google-cloud-sdk/completion.zsh.inc"
source "$BREW_PREFIX/Caskroom/google-cloud-sdk/latest/google-cloud-sdk/path.zsh.inc"

# bookmarks
if [ -d "$HOME/.bookmarks" ]; then
  export CDPATH=".:$HOME/.bookmarks:/"
fi

# gpg
GPG_TTY=$(tty)
export GPG_TTY

export PATH="$PATH:$HOME/.local/bin"
export WORKSPACE="$HOME/workspace"

# ---------------------------------------------------------------------------
# These two must be sourced LAST (after all other widgets are defined).
# autosuggestions: fish-style inline suggestion from history (accept with →).
# syntax-highlighting: colours valid/invalid commands as you type. It MUST be
# the very last plugin sourced or it won't highlight everything correctly.
# ---------------------------------------------------------------------------
[ -f "$BREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh" ] && \
  source "$BREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh"
[ -f "$BREW_PREFIX/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ] && \
  source "$BREW_PREFIX/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
