#!/bin/sh
# pbcopy for Linux: copy stdin to the clipboard (Wayland, X11, or WSL).
if [ -n "${WAYLAND_DISPLAY:-}" ] && command -v wl-copy >/dev/null 2>&1; then exec wl-copy
elif [ -n "${DISPLAY:-}" ] && command -v xclip >/dev/null 2>&1; then exec xclip -selection clipboard -in
elif [ -n "${DISPLAY:-}" ] && command -v xsel  >/dev/null 2>&1; then exec xsel --clipboard --input
elif command -v clip.exe >/dev/null 2>&1; then exec clip.exe
else
  echo "pbcopy: no clipboard available (needs a Wayland/X11 session with wl-clipboard or xclip, or WSL)" >&2
  exit 1
fi
