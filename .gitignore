git/gitconfig.local.symlink
# --- Machine-local / generated ---
Brewfile.lock.json
bin/cloud_sql_proxy
.idea/
.DS_Store
# stray folder some tools create when run with cwd=~/.dotfiles ("Application Support" split)
/Support/

# --- Maven cache & credentials (never commit) ---
packages/maven/m2.symlink/repository/
packages/maven/m2.symlink/wrapper/
packages/maven/m2.symlink/settings.xml*
!packages/maven/m2.symlink/settings.xml.example

# --- Company profiles: each is its own PRIVATE repo, never committed here ---
/profiles/*
!/profiles/README.md
!/profiles/_template/

# --- Secrets: local, never-committed overrides ---
# Any file ending in .local.zsh is machine-local and git-ignored.
*.local.zsh
core/system/env.local.zsh
git/gitconfig.local.symlink

# --- Generic secret files ---
.env
.env.*
*.pem
*.key
*_rsa
*_ed25519
