<?xml version="1.0" encoding="utf-8"?>
<!--
  Template for ~/.m2/settings.xml.

  The REAL settings.xml is git-ignored (see .gitignore) because Artifactory
  "Set Me Up" bakes a personal JWT into every <password> field. Do NOT commit
  the generated file.

  Recommended approach: reference environment variables instead of pasting the
  token 36 times. Provide the values via the Keychain (see system/env.zsh):

      secret-set ARTIFACTORY_USER      # -> cfranzho
      secret-set ARTIFACTORY_TOKEN     # -> paste the JFrog identity token

  Maven expands ${env.ARTIFACTORY_USER} / ${env.ARTIFACTORY_TOKEN} at runtime.
  Add one <server> block per repository id you actually use.
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0 http://maven.apache.org/xsd/settings-1.2.0.xsd">
  <servers>
    <server>
      <id>github</id>
      <username>${env.GITHUB_USER}</username>
      <password>${env.GITHUB_TOKEN}</password>
    </server>
    <server>
      <id>ara-artifactory.volvocars.biz-libs-release</id>
      <username>${env.ARTIFACTORY_USER}</username>
      <password>${env.ARTIFACTORY_TOKEN}</password>
    </server>
    <!-- ... repeat for each ara-artifactory.volvocars.biz-* repository id ... -->
  </servers>

  <profiles>
    <profile>
      <id>artifactory</id>
      <repositories>
        <repository>
          <id>ara-artifactory.volvocars.biz-libs-release</id>
          <name>ara-artifactory-libs-release</name>
          <url>https://ara-artifactory.volvocars.biz/artifactory/libs-release</url>
          <snapshots><enabled>false</enabled></snapshots>
        </repository>
      </repositories>
      <pluginRepositories>
        <pluginRepository>
          <id>ara-artifactory.volvocars.biz-plugins-release</id>
          <name>ara-artifactory.volvocars.biz-plugins-release</name>
          <url>https://ara-artifactory.volvocars.biz/artifactory/plugins-release</url>
          <snapshots><enabled>false</enabled></snapshots>
        </pluginRepository>
      </pluginRepositories>
    </profile>
  </profiles>

  <activeProfiles>
    <activeProfile>artifactory</activeProfile>
  </activeProfiles>
</settings>
