#!/usr/bin/env bash
#
# with-secrets: run ONE command with secrets from Proton Pass in its
# environment. They are never exported into your shell, cached or written.
#
#   with-secrets -- mvn verify                  # every registered secret
#   with-secrets GITHUB_TOKEN -- gh pr list     # only the ones you name
#
# A secret that is already set in the environment is left as is (so direnv or
# a manual export wins). If Proton Pass is unavailable the command still runs,
# just without the missing secrets, after a warning.

set -o pipefail

__dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
# shellcheck source=../lib.sh
source "${__dir}/../lib.sh"

usage() {
    echo "Usage: with-secrets [NAME ...] -- <command> [args...]" >&2
    echo "       (no NAMEs = every secret listed by \`secret list\`)" >&2
    exit "${1:-0}"
}

case "${1:-}" in -h|--help) usage 0 ;; esac

names=()
while [ $# -gt 0 ] && [ "$1" != "--" ]; do
    names+=("$1")
    shift
done
[ "${1:-}" = "--" ] || usage 1
shift
[ $# -gt 0 ] || usage 1

if [ ${#names[@]} -eq 0 ]; then
    while IFS= read -r n; do names+=("$n"); done < <(secrets_names)
fi

# Only fetch what is not already in the environment.
wanted=()
for n in ${names[@]+"${names[@]}"}; do
    [ -n "${!n:-}" ] || wanted+=("$n")
done

if [ ${#wanted[@]} -gt 0 ]; then
    if ! secrets_logged_in; then
        printf 'with-secrets: Proton Pass unavailable (run: secret login); running without: %s\n' "${wanted[*]}" >&2
    else
        for n in "${wanted[@]}"; do
            ref="$(secrets_ref "$n")" || { printf 'with-secrets: no reference named %s\n' "$n" >&2; continue; }
            value="$(secrets_resolve "$ref")" || value=""
            if [ -n "$value" ]; then
                export "$n=$value"
            else
                printf 'with-secrets: could not resolve %s (%s)\n' "$n" "$ref" >&2
            fi
        done
    fi
fi
unset value

exec "$@"
