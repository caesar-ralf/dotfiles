#!/usr/bin/env bash
#
# secret: Proton Pass backed secrets for these dotfiles (see secrets/lib.sh).
# Run `secret help` for the full command list.

set -o pipefail

__dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
# shellcheck source=../lib.sh
source "${__dir}/../lib.sh"
# shellcheck source=../../script/lib/common.sh
source "${DOTFILES}/script/lib/common.sh"

usage() {
    cat <<EOF
secret -- Proton Pass backed secrets, cached in the OS keychain (macOS Keychain / Linux keyring)

Read:
  secret NAME                    Print a secret (cache if fresh, else Proton Pass)
  secret pass://Vault/Item/field Print a secret by reference (never cached)

Discover:
  secret list                    Declared secrets: NAME, TTL, cache age, reference, file
  secret status                  Check login and fetch every secret now (refreshes cache)
  secret scan [FILE ...]         Find \${env.X} / \${X} uses in config files and show
                                 which are declared, set in the shell, or MISSING
                                 (default: ~/.m2/settings.xml)

Manage:
  secret add NAME [opts]         Link NAME to an EXISTING Proton Pass item (fzf pickers)
  secret new NAME [opts]         Create a NEW Proton Pass login item, then link NAME to it
      --feature F                Where to declare it: a top-level feature folder (git,
                                 m2.symlink, ...) or profile:<feature> for the active profile
      --ttl T                    Cache TTL: 30m, 12h, 7d, 0 (never), forever. Default: $SECRETS_DEFAULT_TTL
  secret refresh [NAME ...]      Re-fetch from Proton Pass and re-cache (default: all)
  secret forget [NAME ...]       Drop cached values from the OS keychain (default: all)
  secret login                   Log in to Proton Pass (pass-cli login)

Use secrets in a command (nothing exported to your shell):
  with-secrets -- <command>              all declared secrets
  with-secrets NAME ... -- <command>     only these

Reference format, in <feature>/secrets.refs:
  NAME[:ttl]=pass://<vault name>/<item title>/<field>
EOF
    exit "${1:-0}"
}

need() { command_exists "$1" || fail "'$1' is required for this command (brew install $1)."; }

# --- list / status / scan --------------------------------------------------

cmd_list() {
    local name ref ttl file age cached
    printf '%s%-22s %-8s %-8s %-48s %s%s\n' "$C_BOLD" NAME TTL CACHED REFERENCE "DECLARED IN" "$C_RESET"
    while IFS=$'\t' read -r name ref ttl file; do
        age="$(secrets_cache_age "$name")"
        cached="-"
        [ -n "$age" ] && cached="$(secrets_human_age "$age") ago"
        file="${file#"${DOTFILES}"/}"
        file="${file/#"${DOTFILES_PROFILE_LINK}"/profile:$(active_profile)}"
        printf '%-22s %-8s %-8s %-48s %s%s%s\n' "$name" "$ttl" "$cached" "$ref" "$C_DIM" "$file" "$C_RESET"
    done < <(secrets_list | awk -F'\t' '{ last[$1] = $0; if (!($1 in order)) { order[$1] = ++n; names[n] = $1 } } END { for (i = 1; i <= n; i++) print last[names[i]] }')
}

cmd_status() {
    header "Proton Pass"
    if ! secrets_have_cli; then
        warn "pass-cli not found. Install the Proton Pass CLI, then run: secret login"
        return 1
    fi
    if ! secrets_logged_in; then
        warn "Not logged in. Run: secret login"
        return 1
    fi
    success "Logged in."
    case "$(secrets_cache_backend)" in
        keychain)  note "  Cache: macOS login Keychain (items 'dotfiles:<NAME>')" ;;
        libsecret) note "  Cache: desktop keyring via secret-tool (service=dotfiles)" ;;
        *)         note "  Cache: none (no Keychain/secret-tool+D-Bus); every lookup hits Proton Pass" ;;
    esac

    header "Secrets (fetched now, cache refreshed)"
    local name found=0 bad=0 ref
    while IFS= read -r name; do
        found=1
        ref="$(secrets_entry "$name" | cut -f1)"
        if [ -n "$(secrets_get "$name" --refresh 2>/dev/null)" ]; then
            success "$name ${C_DIM}<- $ref${C_RESET}"
        else
            warn "$name cannot be resolved ${C_DIM}<- $ref${C_RESET}"
            bad=1
        fi
    done < <(secrets_names)
    [ "$found" = 1 ] || note "  No secrets declared yet. Add one with: secret add NAME"
    [ "$bad" = 0 ] || note "  Fix a reference with: secret add NAME   (re-links it to an existing item)"
    return "$bad"
}

cmd_scan() {
    local files=("$@") f var declared
    [ ${#files[@]} -gt 0 ] || files=("$HOME/.m2/settings.xml")
    declared="$(secrets_names)"
    for f in "${files[@]}"; do
        header "${f/#"$HOME"/\~}"
        [ -r "$f" ] || { warn "not readable"; continue; }
        local any=0
        while IFS= read -r var; do
            any=1
            if printf '%s\n' "$declared" | grep -qx "$var"; then
                success "$var ${C_DIM}— declared secret (secret list)${C_RESET}"
            elif [ -n "${!var:-}" ]; then
                info "$var ${C_DIM}— set in your shell (not a secret, or set elsewhere)${C_RESET}"
            else
                warn "$var — MISSING. A secret? secret add $var (existing item) / secret new $var. Not secret? export it in a feature or profile *.zsh"
            fi
        done < <(grep -oE '\$\{(env\.)?[A-Za-z_][A-Za-z0-9_]*\}' "$f" | sed -E 's/^\$\{(env\.)?//; s/\}$//' | awk '!seen[$0]++')
        [ "$any" = 1 ] || note "  No \${...} variables found."
    done
}

# --- refresh / forget ------------------------------------------------------

names_or_all() {
    if [ $# -gt 0 ]; then printf '%s\n' "$@"; else secrets_names; fi
}

cmd_refresh() {
    secrets_logged_in || fail "Not logged in to Proton Pass. Run: secret login"
    local name
    while IFS= read -r name; do
        if [ -n "$(secrets_get "$name" --refresh 2>/dev/null)" ]; then
            success "refreshed $name"
        else
            warn "could not fetch $name"
        fi
    done < <(names_or_all "$@")
}

cmd_forget() {
    local name
    while IFS= read -r name; do
        secrets_cache_forget "$name"
        success "forgot cached $name"
    done < <(names_or_all "$@")
}

# --- add / new -------------------------------------------------------------

# pick PROMPT [--query-ok]: fzf over stdin; prints the choice. With --query-ok,
# typing something that matches nothing returns the typed text.
pick() {
    local prompt="$1" query_ok="${2:-}" out rc
    if [ "$query_ok" = "--query-ok" ]; then
        out="$(fzf --height 50% --layout reverse --prompt "$prompt> " --print-query)"; rc=$?
        case "$rc" in
            0) printf '%s\n' "$out" | sed -n 2p ;;
            1) printf '%s\n' "$out" | sed -n 1p ;;
            *) return 1 ;;
        esac
    else
        fzf --height 50% --layout reverse --prompt "$prompt> "
    fi
}

ask() { # ask "Question" [default] -> prints answer
    local reply
    printf '  %s?%s %s%s ' "$C_YELLOW" "$C_RESET" "$1" "${2:+ [$2]}" >&2
    read -r reply
    printf '%s\n' "${reply:-${2:-}}"
}

valid_secret_name() {
    [[ "$1" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || fail "Invalid NAME '$1' (use an env var name, e.g. GITHUB_TOKEN)."
}

# Resolve --feature spec to a secrets.refs path. Asks with fzf if empty.
feature_refs_file() {
    local spec="$1" profile
    profile="$(active_profile)"
    if [ -z "$spec" ]; then
        spec="$(
            {
                for d in "$DOTFILES"/*/; do
                    d="$(basename "$d")"
                    case "$d" in profiles|functions) continue ;; esac
                    printf '%s\n' "$d"
                done
                if [ -n "$profile" ]; then
                    for d in "$DOTFILES_PROFILE_LINK"/*/; do
                        [ -d "$d" ] && printf 'profile:%s\n' "$(basename "$d")"
                    done
                fi
            } | pick "Declare it in which feature? (type a new name, or profile:<name>)" --query-ok
        )" || return 1
        [ -n "$spec" ] || return 1
    fi
    case "$spec" in
        profile:*)
            [ -n "$profile" ] || fail "No active profile (profile use <name>)."
            printf '%s/%s/secrets.refs\n' "$DOTFILES_PROFILE_LINK" "${spec#profile:}"
            ;;
        */*|.*) fail "Invalid feature '$spec'." ;;
        *) printf '%s/%s/secrets.refs\n' "$DOTFILES" "$spec" ;;
    esac
}

# Write NAME[:ttl]=REF into FILE, replacing an existing NAME line there.
write_ref() {
    local file="$1" name="$2" ttl="$3" ref="$4" lhs tmp
    mkdir -p "$(dirname "$file")"
    if [ ! -f "$file" ]; then
        printf '# Secrets for this feature, fetched from Proton Pass (see ~/.dotfiles/secrets/lib.sh).\n# NAME[:ttl]=pass://<vault name>/<item title>/<field>\n' > "$file"
    fi
    lhs="$name"
    [ -n "$ttl" ] && [ "$ttl" != "$SECRETS_DEFAULT_TTL" ] && lhs="$name:$ttl"
    tmp="$(mktemp)"
    grep -vE "^[[:space:]]*${name}(:[^=]*)?[[:space:]]*=" "$file" > "$tmp" || true
    printf '%s=%s\n' "$lhs" "$ref" >> "$tmp"
    cat "$tmp" > "$file"
    rm -f "$tmp"
    secrets_cache_forget "$name"
    success "Declared ${C_BOLD}${name}${C_RESET} in ${file/#"$HOME"/\~}"
}

# Warn if NAME is also declared in another file (the profile one wins).
warn_shadowing() {
    local name="$1" file="$2" others
    others="$(secrets_list | awk -F'\t' -v n="$name" -v f="$file" '$1 == n && $4 != f { print $4 }')"
    [ -z "$others" ] || warn "$name is also declared in: ${others//$'\n'/, } (active profile wins)"
}

verify_and_cache() {
    local name="$1" value
    value="$(secrets_get "$name" --refresh 2>/dev/null)"
    if [ -n "$value" ]; then
        success "Verified: $name resolves (${#value} chars) and is cached."
    else
        warn "$name does not resolve yet. Check the reference with: secret list"
    fi
}

parse_opts() { # sets OPT_FEATURE OPT_TTL, leaves positional NAME in OPT_NAME
    OPT_FEATURE="" OPT_TTL="" OPT_NAME=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --feature) OPT_FEATURE="${2:-}"; shift ;;
            --ttl)     OPT_TTL="${2:-}"; shift ;;
            -*)        fail "Unknown option: $1" ;;
            *)         [ -z "$OPT_NAME" ] || fail "Only one NAME at a time."; OPT_NAME="$1" ;;
        esac
        shift
    done
    [ -n "$OPT_NAME" ] || usage 1
    valid_secret_name "$OPT_NAME"
    if [ -n "$OPT_TTL" ]; then secrets_ttl_seconds "$OPT_TTL" >/dev/null; fi
}

pick_vault() {
    pass-cli vault list --output json | jq -r '.vaults[].name' | pick "Proton Pass vault"
}

cmd_add() {
    parse_opts "$@"
    need fzf; need jq
    secrets_logged_in || fail "Not logged in to Proton Pass. Run: secret login"
    local name="$OPT_NAME" file vault items line title type id share fields field ref value count

    file="$(feature_refs_file "$OPT_FEATURE")" || fail "Cancelled."
    vault="$(pick_vault)" || fail "Cancelled."
    share="$(pass-cli vault list --output json | jq -r --arg v "$vault" '.vaults[] | select(.name == $v) | .share_id')"

    info "Loading items of '$vault' (can take a few seconds)…"
    items="$(pass-cli item list --share-id "$share" --filter-state active --output json \
        | jq -r '.items[] | select(.item_type != "alias") | [.title, .item_type, .id] | @tsv')"
    line="$(printf '%s\n' "$items" | fzf --height 50% --layout reverse --delimiter=$'\t' --with-nth=1,2 \
        --prompt "Item for $name> ")" || fail "Cancelled."
    title="$(printf '%s' "$line" | cut -f1)"
    type="$(printf '%s' "$line" | cut -f2)"
    id="$(printf '%s' "$line" | cut -f3)"
    count="$(printf '%s\n' "$items" | awk -F'\t' -v t="$title" '$1 == t' | wc -l | tr -d ' ')"
    [ "$count" -le 1 ] || warn "$count items in '$vault' are titled '$title'. Rename one in Proton Pass so the reference is unambiguous."
    case "$title" in */*) note "  Title contains '/': fine, the field is taken after the last '/'." ;; esac

    # Field NAMES only (never values): typed content fields, note, custom fields.
    fields="$(pass-cli item view --share-id "$share" --item-id "$id" --output json | jq -r '
        .item.content as $c
        | ( ($c.content | if type == "object" then (to_entries[0].value // {}) else {} end)
            | if type == "object" then (to_entries[] | select((.value | type) == "string" and .value != "") | .key) else empty end ),
          ( if ($c.note // "") != "" then "note" else empty end ),
          ( [$c.extra_fields[]?, ($c.content | if type == "object" then (to_entries[0].value.sections[]?.fields[]?) else empty end)]
            | .[] | (.name // .field_name // empty) )' | awk '!seen[$0]++')"
    [ -n "$fields" ] || fields="password"
    field="$(printf '%s\n' "$fields" | pick "Field of '$title' ($type)" --query-ok)" || fail "Cancelled."
    [ -n "$field" ] || fail "Cancelled."

    ref="pass://${vault}/${title}/${field}"
    value="$(secrets_resolve "$ref" 2>/dev/null)"
    if [ -z "$value" ]; then
        warn "Field '$field' did not return a value via ${ref}."
        confirm "Declare it anyway?" || fail "Cancelled."
    fi
    unset value

    write_ref "$file" "$name" "$OPT_TTL" "$ref"
    warn_shadowing "$name" "$file"
    verify_and_cache "$name"
}

cmd_new() {
    parse_opts "$@"
    need fzf; need jq
    secrets_logged_in || fail "Not logged in to Proton Pass. Run: secret login"
    local name="$OPT_NAME" file vault title username value ref

    file="$(feature_refs_file "$OPT_FEATURE")" || fail "Cancelled."
    vault="$(pick_vault)" || fail "Cancelled."
    title="$(ask "Item title in Proton Pass" "$name")"
    username="$(ask "Username (optional)" "")"
    printf '  %s?%s Secret value (hidden; empty = generate a random one): ' "$C_YELLOW" "$C_RESET" >&2
    read -rs value
    printf '\n' >&2
    if [ -z "$value" ]; then
        value="$(pass-cli password generate random 2>/dev/null)" || fail "Could not generate a password."
        info "Generated a random value."
    fi

    # The value travels via stdin only (never as a process argument).
    printf '%s' "$value" | jq -Rs --arg t "$title" --arg u "$username" \
        '{title: $t, username: (if $u == "" then null else $u end), email: null,
          password: ., totp_uri: null, urls: [], extra_fields: []}' \
        | pass-cli item create login --vault-name "$vault" --from-template - >/dev/null \
        || fail "Could not create the item in Proton Pass."
    unset value
    success "Created login item '$title' in vault '$vault'."

    ref="pass://${vault}/${title}/password"
    write_ref "$file" "$name" "$OPT_TTL" "$ref"
    warn_shadowing "$name" "$file"
    verify_and_cache "$name"
}

# --- dispatch --------------------------------------------------------------

case "${1:-}" in
    ""|-h|--help|help) usage 0 ;;
    list|ls)      cmd_list ;;
    status)       cmd_status ;;
    scan)         shift; cmd_scan "$@" ;;
    add)          shift; cmd_add "$@" ;;
    new)          shift; cmd_new "$@" ;;
    refresh)      shift; cmd_refresh "$@" ;;
    forget)       shift; cmd_forget "$@" ;;
    login)        exec pass-cli login ;;
    pass://*)     secrets_resolve "$1" ;;
    -*)           warn "Invalid option: $1"; usage 1 ;;
    *)            valid_secret_name "$1"; secrets_get "$1" ;;
esac
