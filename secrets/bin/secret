#!/usr/bin/env bash
#
# secret: fetch secrets from Proton Pass on demand. Nothing is cached or
# written to disk; see secrets/lib.sh for how references are declared.
#
#   secret NAME                        print the secret registered as NAME
#   secret pass://Vault/Item/field     print a secret by reference
#   secret list                        list every registered NAME -> reference
#   secret status                      check login + that every reference resolves
#   secret login                       log in to Proton Pass (pass-cli login)

set -o errexit
set -o pipefail

__dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
# shellcheck source=../lib.sh
source "${__dir}/../lib.sh"
# shellcheck source=../../script/lib/common.sh
source "${DOTFILES}/script/lib/common.sh"

usage() {
    cat <<EOF
secret -- fetch secrets from Proton Pass on demand (nothing is stored locally)

Usage:
  secret NAME                      Print the secret registered as NAME
  secret pass://Vault/Item/field   Print a secret by reference
  secret list                      List registered NAMEs and their references
  secret status                    Check Proton Pass login and every reference
  secret login                     Log in to Proton Pass (pass-cli login)

References live in <feature>/secrets.refs files (global and active profile):
  NAME=pass://<vault name>/<item title>/<field>

Run a command with secrets in its environment:  with-secrets -- <command>
EOF
    exit "${1:-0}"
}

cmd_list() {
    local name ref file
    while IFS=$'\t' read -r name ref file; do
        printf '%-24s %s  %s(%s)%s\n' "$name" "$ref" "$C_DIM" "${file#"${DOTFILES}"/}" "$C_RESET"
    done < <(secrets_list)
}

cmd_status() {
    header "Proton Pass"
    if ! secrets_have_cli; then
        warn "pass-cli not found. Install the Proton Pass CLI, then run: secret login"
        return 1
    fi
    if ! secrets_logged_in; then
        warn "Not logged in. Run: secret login"
        return 1
    fi
    success "Logged in."

    header "Secret references"
    local name ref found=0
    while IFS= read -r name; do
        found=1
        ref="$(secrets_ref "$name")"
        if [ -n "$(secrets_resolve "$ref" 2>/dev/null)" ]; then
            success "$name ${C_DIM}<- $ref${C_RESET}"
        else
            warn "$name cannot be resolved ${C_DIM}<- $ref${C_RESET}"
        fi
    done < <(secrets_names)
    [ "$found" = 1 ] || note "  No secrets.refs files found."
}

case "${1:-}" in
    ""|-h|--help) usage 0 ;;
    list)         cmd_list ;;
    status)       cmd_status ;;
    login)        exec pass-cli login ;;
    pass://*)     secrets_resolve "$1" ;;
    -*)           warn "Invalid option: $1"; usage 1 ;;
    *)
        ref="$(secrets_ref "$1")" || { printf 'secret: no reference named %s (see: secret list)\n' "$1" >&2; exit 1; }
        secrets_resolve "$ref"
        ;;
esac
