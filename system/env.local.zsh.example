# Machine-local, git-ignored secrets and overrides.
#
# Copy this file to `env.local.zsh` (same folder) and fill in real values:
#     cp system/env.local.zsh.example system/env.local.zsh
#
# `env.local.zsh` is git-ignored and auto-sourced by ~/.zshrc AFTER env.zsh,
# so anything set here overrides the Keychain-based defaults.
#
# PREFERRED: keep secrets in the macOS Keychain instead (see system/env.zsh):
#     secret-set GITHUB_TOKEN
#     secret-set ARTIFACTORY_TOKEN
# and leave this file for non-secret machine-specific tweaks.

# export GITHUB_TOKEN='paste-from-proton-pass'
# export ARTIFACTORY_USER='cfranzho'
# export ARTIFACTORY_TOKEN='paste-from-proton-pass'
