# Machine-local, git-ignored overrides.
#
# Copy this file to `env.local.zsh` (same folder):
#     cp system/env.local.zsh.example system/env.local.zsh
#
# `env.local.zsh` is git-ignored and auto-sourced on shell start.
#
# Do NOT put secrets here. Fetch them from Proton Pass when needed:
#     secret GITHUB_TOKEN              # print one
#     with-secrets -- some-command     # inject into one command
# Company-specific settings belong in a profile (see profiles/README.md).

# export PROJECTS="$HOME/code"
