#!/usr/bin/env bash
#
# bootstrap — set up this machine from a fresh checkout.
#
# It will, in order:
#   1. Create git/gitconfig.local.symlink (asks for your name/email once).
#   2. Symlink every *.symlink file into $HOME.
#   3. (macOS) Install Homebrew + all dependencies via `script/dot`.
#   4. Check your Proton Pass login and secret references (`secret status`).
#   5. Point you at the company profile commands (`profile`).
#
# It is safe to re-run: existing symlinks are detected and you are asked what
# to do with anything that already exists. Set DOTFILES_YES=1 to auto-confirm.

## constants
__dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
source "${__dir}/lib/common.sh"

## set flags
# Exit on error. Append "|| true" if you expect an error.
set -o errexit
# Exit on error inside any functions or subshells.
set -o errtrace
# Catch the error in case pipe fails
set -o pipefail
# Turn on traces, useful while debugging but commented out by default
[[ "${DEBUG:-}" = true ]] && set -o xtrace

setup_gitconfig() {
    header "Git config"
    if [ -f "${DOTFILES}/git/gitconfig.local.symlink" ]; then
        success "git/gitconfig.local.symlink already exists."
        return 0
    fi

    info "Setting up git/gitconfig.local.symlink"

    local git_credential='cache'
    is_macos && git_credential='osxkeychain'

    user 'What is your git author name?'
    read -r -e git_authorname
    user 'What is your git author email?'
    read -r -e git_authoremail

    sed -e "s/AUTHORNAME/$git_authorname/g" \
        -e "s/AUTHOREMAIL/$git_authoremail/g" \
        -e "s/GIT_CREDENTIAL_HELPER/$git_credential/g" \
        "${DOTFILES}/git/gitconfig.local.symlink.example" \
        > "${DOTFILES}/git/gitconfig.local.symlink"

    success "Created git/gitconfig.local.symlink"
}

link_file() {
    local src=$1 dst=$2

    local overwrite= backup= skip=
    local action=

    if [ -f "$dst" ] || [ -d "$dst" ] || [ -L "$dst" ]; then
        if [ "$overwrite_all" == "false" ] && [ "$backup_all" == "false" ] && [ "$skip_all" == "false" ]; then
            local currentSrc
            currentSrc="$(readlink "$dst")"

            if [ "$currentSrc" == "$src" ]; then
                skip=true
            else
                user "File already exists: $(basename "$dst") ($(basename "$src")), what do you want to do?"
                note "  [s]kip, [S]kip all, [o]verwrite, [O]verwrite all, [b]ackup, [B]ackup all?"
                read -r -n 1 action
                printf '\n'

                case "$action" in
                    o ) overwrite=true ;;
                    O ) overwrite_all=true ;;
                    b ) backup=true ;;
                    B ) backup_all=true ;;
                    s ) skip=true ;;
                    S ) skip_all=true ;;
                    * ) ;;
                esac
            fi
        fi

        overwrite=${overwrite:-$overwrite_all}
        backup=${backup:-$backup_all}
        skip=${skip:-$skip_all}

        if [ "$overwrite" == "true" ]; then
            rm -rf "$dst"
            success "removed $dst"
        fi

        if [ "$backup" == "true" ]; then
            mv "$dst" "${dst}.backup"
            success "moved $dst to ${dst}.backup"
        fi

        if [ "$skip" == "true" ]; then
            note "  skipped $(basename "$src") (already linked)"
        fi
    fi

    if [ "$skip" != "true" ]; then  # "false" or empty
        ln -s "$1" "$2"
        success "linked $(basename "$1") → $2"
    fi
}

install_dotfiles() {
    header "Symlinking dotfiles into \$HOME"

    local overwrite_all=false backup_all=false skip_all=false
    [ "${DOTFILES_YES:-0}" = "1" ] && skip_all=true

    # Features live at most 2 levels deep (git/, packages/maven/), so their
    # *.symlink entries are at depth <= 3. Profiles link their own files.
    local src dst
    for src in $(find -H "${DOTFILES}" -maxdepth 3 -name '*.symlink' -not -path '*.git*' -not -path "${DOTFILES}/profiles/*"); do
        dst="$HOME/.$(basename "${src%.*}")"
        link_file "$src" "$dst"
    done
}

install_dependencies() {
    if ! is_macos; then
        note "  Not on macOS — skipping Homebrew/dependency installation."
        return 0
    fi

    header "Installing dependencies (Homebrew, Brewfile, installers)"
    if "${DOTFILES}/script/dot" --no-edit; then
        success "Dependencies installed."
    else
        fail "Error installing dependencies."
    fi
}

setup_secrets() {
    header "Secrets (Proton Pass)"
    local secret_cmd="${DOTFILES}/security/secrets/bin/secret"
    if ! command_exists pass-cli; then
        warn "pass-cli not found. Install the Proton Pass CLI, then run: secret login"
        return 0
    fi
    if pass-cli test >/dev/null 2>&1; then
        success "Logged in to Proton Pass."
    elif confirm "Log in to Proton Pass now?"; then
        pass-cli login || warn "Login failed. Retry later with: secret login"
    else
        note "  You can do this later with: secret login"
        return 0
    fi
    "$secret_cmd" status || true
}

setup_profile() {
    header "Company profile"
    local name
    name="$(active_profile)"
    if [ -n "$name" ]; then
        success "Active profile: ${name}"
        return 0
    fi
    "${DOTFILES}/script/profile" list
    note "  Get a profile:  profile clone <private-repo-url>   or   profile new <name>"
    note "  Activate it:    profile use <name>"
}

main() {
    # Say hello, and wave goodbye with the right face no matter how we exit.
    trap 'wizard_farewell $?' EXIT
    wizard --happy "Greetings! I'm your setup wizard. Sit tight while I conjure your dotfiles into place."
    # Nested scripts (dot, install) shouldn't print their own wizard on top of ours.
    export DOTFILES_WIZARD_GREETED=1

    banner "Bootstrapping your dotfiles"
    setup_gitconfig
    install_dotfiles
    install_dependencies
    setup_shell
    setup_secrets
    setup_profile

    header "Done"
    success "All installed! 🎉"
    note "  Open a new terminal (or run: exec zsh) to load everything."
    echo
}

main "$@"
