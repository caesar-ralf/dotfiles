#!/usr/bin/env bash
#
# Run all dotfiles installers.

## constants
__dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
source "${__dir}/lib/common.sh"

## set flags
# Exit on error. Append "|| true" if you expect an error.
set -o errexit
# Exit on error inside any functions or subshells.
set -o errtrace
# Catch the error in case pipe fails
set -o pipefail
# Turn on traces, useful while debugging but commented out by default
[[ "${DEBUG:-}" = true ]] && set -o xtrace

# Wave goodbye with the right face however we exit. Only greet when run directly
# (not when invoked from `dot`, which prints its own wizard) to avoid double art.
if [ "${DOTFILES_WIZARD_GREETED:-0}" != "1" ]; then
    trap 'wizard_farewell $?' EXIT
    wizard "Time to gather your tools. Let me fetch the good stuff..."
fi

# Run Homebrew through the Brewfile.
header "brew bundle"
if command_exists brew; then
    brew bundle --file="${DOTFILES}/Brewfile"
    success "Brewfile applied."
else
    warn "brew not found on PATH — skipping Brewfile."
fi

# Find every topic installer and run it. Prune the huge Maven cache so we don't
# walk 16k+ directories under m2.symlink/repository looking for install.sh.
header "Running topic installers"
while IFS= read -r installer; do
    info "→ ${installer#"${DOTFILES}"/}"
    sh -c "$installer"
done < <(find "${DOTFILES}" \
            -path "${DOTFILES}/m2.symlink/repository" -prune -o \
            -type f -name install.sh -print)

header "Done"
success "All installers finished."
