#!/usr/bin/env bash
#
# secrets — interactively set up the secrets this dotfiles setup expects.
#
# No secrets are ever committed to this repo. This helper stores them in the
# macOS login Keychain (preferred) so they are loaded automatically on every
# shell start by system/env.zsh, or helps you create a git-ignored local file.
#
# Run it any time — it is idempotent and shows what is already configured:
#     script/secrets            # interactive setup
#     script/secrets --status   # just show what is / isn't set
#     script/secrets --local    # create system/env.local.zsh from the example

## constants
__dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
source "${__dir}/lib/common.sh"

## set flags
set -o errexit
set -o errtrace
set -o pipefail
[[ "${DEBUG:-}" = true ]] && set -o xtrace

# The secrets this setup knows about. Format: "NAME|description|secret?"
# secret? = "yes" -> value is hidden while typing; "no" -> plain (e.g. usernames)
SECRETS=(
    "GITHUB_TOKEN|GitHub personal access token (repo + read:packages)|yes"
    "ARTIFACTORY_USER|Artifactory username (not secret, but needed by ~/.m2)|no"
    "ARTIFACTORY_TOKEN|Artifactory identity token / JWT for Maven|yes"
)

usage() {
    cat <<EOF
secrets -- set up the secrets this dotfiles setup expects

Usage: script/secrets [options]

Options:
  (no args)     Interactive setup: prompts for each secret and stores it
                in the macOS Keychain (skips ones already set unless you
                choose to update them).
  -s, --status  Show which expected secrets are already configured.
  -l, --local   Create system/env.local.zsh from the example template.
  -h, --help    Show this help message and exit.
EOF
    exit "${1:-0}"
}

# --- Keychain helpers (macOS) ----------------------------------------------
keychain_get() { security find-generic-password -a "$USER" -s "$1" -w 2>/dev/null; }
keychain_set() { security add-generic-password -a "$USER" -s "$1" -U -w "$2"; }

# Split a "NAME|desc|secret?" entry into globals for readability.
_parse() {
    IFS='|' read -r S_NAME S_DESC S_HIDDEN <<<"$1"
}

show_status() {
    header "Secret status"
    if ! is_macos; then
        warn "Keychain storage is macOS-only. On this OS, use a local file:"
        note "  script/secrets --local"
        return 0
    fi
    local entry
    for entry in "${SECRETS[@]}"; do
        _parse "$entry"
        if [ -n "$(keychain_get "$S_NAME")" ]; then
            success "$S_NAME ${C_DIM}— set${C_RESET}"
        else
            warn "$S_NAME — not set ${C_DIM}($S_DESC)${C_RESET}"
        fi
    done
}

create_local_file() {
    header "Local secrets file"
    local example="${DOTFILES}/system/env.local.zsh.example"
    local target="${DOTFILES}/system/env.local.zsh"
    if [ -f "$target" ]; then
        success "system/env.local.zsh already exists — leaving it untouched."
    else
        cp "$example" "$target"
        success "Created system/env.local.zsh from the example template."
        info "Edit it and add your exports, then open a new shell."
    fi
    if command_exists "${EDITOR:-}"; then
        confirm "Open it in \$EDITOR now?" && "$EDITOR" "$target"
    fi
}

interactive_setup() {
    banner "Secrets setup"
    if ! is_macos; then
        warn "Keychain storage is only available on macOS."
        info "Falling back to a git-ignored local file instead."
        create_local_file
        return 0
    fi

    note "Values are stored in your login Keychain and loaded automatically by"
    note "system/env.zsh on every new shell. Nothing is written to git."
    note "The first Keychain read per app may prompt once — choose \"Always Allow\"."

    local entry value
    for entry in "${SECRETS[@]}"; do
        _parse "$entry"
        header "$S_NAME"
        note "$S_DESC"

        if [ -n "$(keychain_get "$S_NAME")" ]; then
            success "Already set in Keychain."
            confirm "Update it?" || { info "Keeping existing value."; continue; }
        fi

        if [ "$S_HIDDEN" = "yes" ]; then
            printf '  %s?%s Enter value (hidden, leave empty to skip): ' "$C_YELLOW" "$C_RESET"
            read -rs value
            printf '\n'
        else
            printf '  %s?%s Enter value (leave empty to skip): ' "$C_YELLOW" "$C_RESET"
            read -r value
        fi

        if [ -z "$value" ]; then
            warn "Skipped $S_NAME."
            continue
        fi

        keychain_set "$S_NAME" "$value"
        success "Stored $S_NAME in the Keychain."
    done

    header "Optional: local overrides file"
    if confirm "Also create system/env.local.zsh for non-secret machine tweaks?"; then
        create_local_file
    fi

    echo
    show_status
    echo
    success "Secrets setup complete. Open a new shell (or run: exec zsh) to load them."
}

# --- Argument parsing ------------------------------------------------------
case "${1:-}" in
    -h|--help)   usage 0 ;;
    -s|--status) show_status ;;
    -l|--local)  create_local_file ;;
    "")          interactive_setup ;;
    *)           warn "Invalid option: $1"; usage 1 ;;
esac
