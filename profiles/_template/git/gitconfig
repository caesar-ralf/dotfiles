# Company git settings. Included LAST by ~/.dotfiles/git/gitconfig.symlink,
# so anything here overrides the shared and machine-local config.
[user]
    email = you@company.example

# Username for a company git host (the password/token comes from the
# credential helper, never from this file).
# [credential "https://git.company.example"]
#     username = you

# Directory-scoped identity, e.g. only for repos under ~/workspace/company:
# [includeIf "gitdir:~/workspace/company/"]
#     path = ~/.config/dotfiles/profile/git/gitconfig.work

# Jira project keys used at this company. The commit-msg hook then ONLY adds
# tickets with these keys (no false positives like UTF-8 or SHA-256).
# Check what it would do on a branch with `git ticket`.
# [hooks]
#     ticketProjects = ABC DEF
