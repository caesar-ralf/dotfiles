# Local/private config goes in the include
[include]
    path = ~/.gitconfig.local
[hub]
    protocol = https
[alias]
    co = checkout
    promote = !$DOTFILES/bin/git-promote
    wtf     = !$DOTFILES/bin/git-wtf
    rank-contributors = !$DOTFILES/bin/git-rank-contributors
    count   = !git shortlog -sn
    cob = checkout -b
    ci = commit
    st = status -s
    br = branch
    # different ways to show our commits, depending on what we are looking for
    ls = log --pretty=format:\"%C(yellow)%h%Cred%d %Creset%s%Cblue [%cn]\" --decorate
    ll = log --pretty=format:\"%C(yellow)%h%Cred%d %Creset%s%Cblue [%cn]\" --decorate --numstat
    lnc = log --pretty=format:\"%h %s [%cn]\"
    # Show changes that have been staged
    diffc = diff --cached
    # saves all updates as Working in Progress. USE WITH CARE!
    wip = !git add -u && git commit -m "WIP"
    # remove a file from staging
    unstage = reset HEAD --
    # show what the last commit has
    last = log -1 HEAD
    # list all aliases that we added :D
    list-aliases = !git config -l | grep alias | cut -c 7-
    # remove last commit
    undo-commit = reset --soft HEAD~
    # Shows current branch-name. Useful for other aliases.
    branch-name = !git rev-parse --abbrev-ref HEAD
    # Push the current branch to the remote "origin", and set it to track
    # the upstream branch
    publish = "!git push -u origin $(git branch-name)"
    # Delete the remote version of the current branch
    unpublish = "!git push origin :$(git branch-name)"
    # Remove already merged branches
    cleanup = "!f() { git fetch --all --prune; git branch -vv | awk '/: gone]/{print $1}' | xargs git branch -D; }; f"
    # your basic amend
    amend = commit --amend
    forgot-something-2-commit = commit --amend --no-edit
    stash-unapply = !git stash show -p | git apply -R
    # pull & cleanup
    update = "!git pull && git cleanup"
    # GRaphical lOG
    grog = log --graph --abbrev-commit --decorate --all --format=format:\"%C(bold blue)%h%C(reset) - %C(bold cyan)%aD%C(dim white) - %an%C(reset) %C(bold green)(%ar)%C(reset)%C(bold yellow)%d%C(reset)%n %C(white)%s%C(reset)\"
    # stash only untracked files
    stsh = stash --keep-index
    # stash including untracked, but not new
    staash = stash --include-untracked
    # stash EVERYTHING!
    staaash = stash --all
    # push asking nicelly
    please = push --force-with-lease
    # pretty log
    lg = log --graph --abbrev-commit --decorate --all \
        --format=format:\"%C(bold blue)%h%C(reset) - %C(bold cyan)%aD%C(dim white) \
        - %an%C(reset) %C(bold green)(%ar)%C(reset)%C(bold yellow)%d%C(reset)%n %C(white)%s%C(reset)\"
    # diff tool
    dft = difftool
# Use a pager for large output, just like other git commands.
[pager]
    difftool = true
[push]
    default = simple
[init]
    templatedir = ~/.git_global
    defaultBranch = main
[core]
    excludesfile = ~/.gitignore
	pager = delta
	autocrlf = input
[filter "lfs"]
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
    required = true
    clean = git-lfs clean -- %f
[branch]
    autosetuprebase = always
    sort = -committerdate
[lfs]
    locksverify = false
[submodule]
    recurse = true
[diff]
    # https://difftastic.wilfred.me.uk/
    tool = difftastic
    # handles functions being reordered: https://luppeng.wordpress.com/2020/10/10/when-to-use-each-of-the-git-diff-algorithms/
    algorithm = histogram
    # uses different colours to highlight lines in diffs that have been “moved”
    colorMoved = default
    # ignores indentation changes
    colorMovedWS = allow-indentation-change
    submodule = log
[difftool]
    prompt = false
[difftool "difftastic"]
    cmd = difft "$LOCAL" "$REMOTE"
[merge]
	conflictStyle = zdiff3
[rebase]
    autosquash = true
    autostash = true
[pull]
    rebase = true
[rerere]
    enabled = true
[help]
    autocorrect = 1
# fix URLs that I mistakenly cloned using the HTTP
[url "git@github.com:"]
    insteadOf = "https://github.com/"
[url "git@gist.github.com:"]
    insteadOf = https://gist.github.com/
[transfer]
    fsckobjects = true
[fetch]
    fsckobjects = true
    prune = true
[receive]
    fsckobjects = true
[log]
    date = iso
[status]
    submoduleSummary = true
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
[gpg]
	format = ssh
[gpg "ssh"]
	program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
[commit]
	gpgsign = true
[user]
	signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIEM/Nysjlp6nVFqp9vyzaZ49IiHthuw/VWQ0QnOmNnmW
[credential "https://gitlab.oss.volvoc3.com"]
	username = cfranzho
[tag]
	gpgsign = false
